   "source": [
    "Free Space Path Loss (FSPL) "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "1b94b95d",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "metadata": {},
   "outputs": [],
   "source": [
    "def fspl(voltage: float, power: float) -> float:\n",
    "    fspl = 32.45 + 20 * np.log10(voltage) + 20 * np.log10(power)\n",
    "    return fspl"
   ]
  },
  {
